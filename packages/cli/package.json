{
  "name": "@agentvalet/register",
  "version": "1.0.1",
  "description": "Self-register AI agents with AgentValet",
  "type": "module",
  "bin": {
    "agentvalet-register": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean --shims",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@agentvalet/mcp-server": "workspace:^",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@octokit/auth-oauth-device": "^7.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "conf": "^13.0.0",
    "jose": "^6.2.2",
    "open": "^10.0.0",
    "ora": "^8.0.1",
    "prompts": "^2.4.2",
    "undici": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.4.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentvalet/agentvalet.git"
  },
  "homepage": "https://agentvalet.ai",
  "bugs": {
    "url": "https://github.com/agentvalet/agentvalet/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "ai",
    "agents",
    "auth",
    "credentials",
    "mcp",
    "valet",
    "agentvalet"
  ],
  "license": "MIT"
}
